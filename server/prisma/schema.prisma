generator client {
  provider = "prisma-client-js"
}

generator typegraphql {
  provider            = "typegraphql-prisma"
  output              = "../src/database/src/type-graphql"
  formatGeneratedCode = "prettier"
  useSimpleInputs     = "true"
  simpleResolvers     = "true"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pokemon {
  id                 Int                  @id @unique @default(autoincrement())
  number             Int                  @unique
  name               String               @db.VarChar(50)
  type               String[]
  isRegion           Boolean?             @default(false) @map("is_region")
  isMega             Boolean?             @default(false) @map("is_mega")
  typeSingle1        String               @map("type_single1") @db.VarChar(20)
  typeSingle2        String?              @map("type_single2") @db.VarChar(20)
  isEvolution        Boolean              @default(false) @map("is_evolution")
  evolutionId        Int[]                @map("evolution_id")
  generation         Int                  @map("generation")
  isForm             Boolean              @default(false) @map("is_form")
  abilityId          Int[]                @map("ability_id")
  NormalStats        NormalStats?
  PokemonAbilityList PokemonAbilityList[]
  PokemonMega        PokemonMega[]
  PokemonNormalForm  PokemonNormalForm[]
  PokemonRegion      PokemonRegion[]

  @@map("pokemon")
}

model PokemonNormalForm {
  id                           Int                            @id @unique @default(autoincrement())
  pokemonId                    Int                            @map("pokemon_id")
  name                         String                         @map("name") @db.VarChar(50)
  type                         String[]
  typeSingle1                  String                         @map("type_single1") @db.VarChar(20)
  typeSingle2                  String?                        @map("type_single2") @db.VarChar(20)
  imagePath                    String                         @map("image_path") @db.VarChar(50)
  statCode                     String                         @unique @map("stat_code") @db.VarChar(10)
  abilityId                    Int[]                          @map("ability_id")
  FormStats                    FormStats[]
  pokemon                      Pokemon                        @relation(fields: [pokemonId], references: [number])
  PokemonNormalFormAbilityList PokemonNormalFormAbilityList[]

  @@map("pokemon_normal_form")
}

model PokemonRegion {
  id                           Int                            @id @unique @default(autoincrement())
  pokemonId                    Int                            @map("pokemon_id")
  pokemonNumber                Int                            @map("pokemon_number")
  region                       String                         @db.VarChar(20)
  type                         String[]
  typeSingle1                  String                         @map("type_single1") @db.VarChar(20)
  typeSingle2                  String?                        @map("type_single2") @db.VarChar(20)
  statCode                     String                         @unique @map("stat_code") @db.VarChar(10)
  abilityId                    Int[]                          @map("ability_id")
  name                         String                         @default("") @map("name") @db.VarChar(50)
  pokemon                      Pokemon                        @relation(fields: [pokemonId], references: [number])
  PokemonRegionFormAbilityList PokemonRegionFormAbilityList[]
  RegionStats                  RegionStats[]

  @@map("pokemon_region")
}

model PokemonMega {
  id            Int         @id @unique @default(autoincrement())
  pokemonId     Int         @map("pokemon_id")
  pokemonNumber Int         @map("pokemon_number")
  type          String[]
  typeSingle1   String      @map("type_single1") @db.VarChar(20)
  typeSingle2   String?     @map("type_single2") @db.VarChar(20)
  statCode      String      @unique @map("stat_code") @db.VarChar(10)
  abilityId     Int[]       @map("ability_id")
  name          String      @default("") @map("name") @db.VarChar(50)
  MegaStats     MegaStats[]
  pokemon       Pokemon     @relation(fields: [pokemonId], references: [number])

  @@map("pokemon_mega")
}

model TypeRelation {
  id         Int     @id @unique @default(autoincrement())
  type       String  @db.VarChar(20)
  strong     String?
  weak       String?
  invalidity String?

  @@map("type_relation")
}

model NormalStats {
  id             Int     @id @unique @default(autoincrement())
  pokemonId      Int     @unique @map("pokemon_id")
  hp             Int     @map("hp")
  attack         Int     @map("attack")
  defense        Int     @map("defense")
  specialAttack  Int     @map("special_attack")
  specialDefense Int     @map("special_defense")
  speed          Int     @map("speed")
  total          Int     @map("total")
  pokemon        Pokemon @relation(fields: [pokemonId], references: [number])

  @@map("normal_stats")
}

model MegaStats {
  id             Int         @id @unique @default(autoincrement())
  statCode       String      @map("stat_code") @db.VarChar(10)
  hp             Int         @map("hp")
  attack         Int         @map("attack")
  defense        Int         @map("defense")
  specialAttack  Int         @map("special_attack")
  specialDefense Int         @map("special_defense")
  speed          Int         @map("speed")
  total          Int         @map("total")
  megaPokemon    PokemonMega @relation(fields: [statCode], references: [statCode])

  @@map("mega_stats")
}

model RegionStats {
  id             Int           @id @unique @default(autoincrement())
  statCode       String        @map("stat_code") @db.VarChar(10)
  hp             Int           @map("hp")
  attack         Int           @map("attack")
  defense        Int           @map("defense")
  specialAttack  Int           @map("special_attack")
  specialDefense Int           @map("special_defense")
  speed          Int           @map("speed")
  total          Int           @map("total")
  regionPokemon  PokemonRegion @relation(fields: [statCode], references: [statCode])

  @@map("region_stats")
}

model FormStats {
  id                Int               @id @unique @default(autoincrement())
  statCode          String            @map("stat_code") @db.VarChar(10)
  hp                Int               @map("hp")
  attack            Int               @map("attack")
  defense           Int               @map("defense")
  specialAttack     Int               @map("special_attack")
  specialDefense    Int               @map("special_defense")
  speed             Int               @map("speed")
  total             Int               @map("total")
  normalFormPokemon PokemonNormalForm @relation(fields: [statCode], references: [statCode])

  @@map("form_stats")
}

model UseCount {
  id         Int @id @unique @default(autoincrement())
  totalCount Int @default(0) @map("total_count")
  todayCount Int @default(0) @map("today_count")

  @@map("use_count")
}

model VisitLog {
  id         Int      @id @unique @default(autoincrement())
  logDate    DateTime @default(now()) @map("log_date") @db.Timestamp(6)
  visitCount Int      @map("visit_count")

  @@map("visit_log")
}

model PokemonAbilities {
  id                           Int                            @id @unique @default(autoincrement())
  name                         String                         @map("ability_name") @db.VarChar(50)
  abilityId                    Int                            @unique @map("ability_id")
  description                  String                         @map("description")
  PokemonAbilityList           PokemonAbilityList[]
  PokemonRegionFormAbilityList PokemonRegionFormAbilityList[]

  @@map("pokemon_abilities")
}

model PokemonAbilityList {
  id               Int              @id @unique @default(autoincrement())
  isHidden         Boolean          @default(false) @map("is_hidden")
  abilityId        Int              @map("ability_id")
  pokemonId        Int              @map("pokemon_id")
  PokemonAbilities PokemonAbilities @relation(fields: [abilityId], references: [abilityId])
  Pokemon          Pokemon          @relation(fields: [pokemonId], references: [number])

  @@map("pokemon_ability_list")
}

model PokemonNormalFormAbilityList {
  id                Int               @id @unique @default(autoincrement())
  isHidden          Boolean           @default(false) @map("is_hidden")
  statCode          String            @map("stat_code")
  abilityId         Int               @map("ability_id")
  PokemonNormalForm PokemonNormalForm @relation(fields: [statCode], references: [statCode])

  @@map("pokemon_normal_form_ability_list")
}

model PokemonRegionFormAbilityList {
  id               Int              @id @unique @default(autoincrement())
  isHidden         Boolean          @default(false) @map("is_hidden")
  statCode         String           @map("stat_code")
  abilityId        Int              @map("ability_id")
  PokemonAbilities PokemonAbilities @relation(fields: [abilityId], references: [abilityId])
  PokemonRegion    PokemonRegion    @relation(fields: [statCode], references: [statCode])

  @@map("pokemon_region_form_ability_list")
}
